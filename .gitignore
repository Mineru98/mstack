# upstream: https://github.com/cursor/plugins/blob/main/pstack/.gitignore
# ============================================================
# macOS
# ============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon

# Thumbnails
._*

# Volume metadata
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ============================================================
# Logs
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Node
# ============================================================
node_modules/
.pnpm-store/
.yarn-integrity

# Build output (Python 빌드 산출물도 여기서 함께 처리)
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
.turbo/

# Test coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ============================================================
# Python
# ============================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/

# Jupyter
.ipynb_checkpoints/

# ============================================================
# Environment & secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Editors
# ============================================================
.idea/

# VS Code: 기본은 무시, 팀 공유용 설정만 예외 허용
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.codegraph
.om*
.gjc
.ouroboros
